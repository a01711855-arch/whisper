<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Animación baño</title>
  <style>
    body {
      margin: 0;
      background: #e0f7fa;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: flex-end;
      overflow: hidden;
    }

    .bathroom {
      position: relative;
      width: 800px;
      height: 400px;
      background: #f5f5f5;
      border: 5px solid #555;
      border-radius: 10px;
    }

    .door {
      position: absolute;
      left: 20px;
      bottom: 0;
      width: 80px;
      height: 200px;
      background: #8d6e63;
      border: 3px solid #4e342e;
      border-radius: 5px;
    }

    .sink {
      position: absolute;
      right: 40px;
      bottom: 60px;
      width: 80px;
      height: 40px;
      background: #90caf9;
      border-radius: 10px;
      border: 3px solid #1565c0;
    }

    .faucet {
      position: absolute;
      top: -20px;
      left: 30px;
      width: 20px;
      height: 20px;
      background: #555;
      border-radius: 50%;
    }

    .person {
      position: absolute;
      bottom: 0;
      left: -100px;
      width: 40px;
      height: 120px;
      display: flex;
      flex-direction: column;
      align-items: center;
      animation: walk 10s linear forwards;
    }

    .head {
      width: 40px;
      height: 40px;
      background: #ffcc80;
      border-radius: 50%;
    }

    .body {
      width: 10px;
      height: 60px;
      background: #000;
    }

    .arms {
      position: absolute;
      top: 50px;
      display: flex;
      justify-content: space-between;
      width: 80px;
    }

    .arm {
      width: 10px;
      height: 40px;
      background: #000;
    }

    .legs {
      display: flex;
      justify-content: space-between;
      width: 40px;
      margin-top: auto;
    }

    .leg {
      width: 10px;
      height: 50px;
      background: #000;
    }

    @keyframes walk {
      0%   { left: -100px; }
      50%  { left: 200px; }
      100% { left: 660px; }
    }

    /* animación de agua */
    .water {
      position: absolute;
      top: -30px;
      left: 35px;
      width: 10px;
      height: 0;
      background: #2196f3;
      animation: waterFlow 2s infinite;
    }

    @keyframes waterFlow {
      0% { height: 0; }
      50% { height: 30px; }
      100% { height: 0; }
    }
  </style>
</head>
<body>
  <div class="bathroom">
    <div class="door"></div>
    <div class="sink">
      <div class="faucet"></div>
      <div class="water"></div>
    </div>
    <div class="person">
      <div class="head"></div>
      <div class="arms">
        <div class="arm"></div>
        <div class="arm"></div>
      </div>
      <div class="body"></div>
      <div class="legs">
        <div class="leg"></div>
        <div class="leg"></div>
      </div>
    </div>
  </div>
</body>
</html>
